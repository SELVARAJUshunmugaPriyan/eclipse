package oops;

class Jewel
{
	String metal, type;
	char size;
	Gold gold;
	Silver silver;
	boolean hasStone;
}

class Gold
{
	float weight;
	int price;
	Stone stone;
}

class Silver
{
	float weight;
	int price;
	Stone stone;
}

class Stone
{
	String type;
}

public class UseJewel 
{

	public static void main(String[] args) 
	{
		// TODO Auto-generated method stub
		Jewel jewelA = new Jewel(), jewelB = new Jewel();
		Gold g = new Gold();
		Silver s = new Silver();
		Stone st = new Stone();
//		Stone st2 = new Stone();
		
		jewelA.metal = "gold";
		jewelA.type = "ring";
		jewelA.size = 'S';
		jewelA.gold = g;
		jewelA.gold.price = 75000;
		jewelA.gold.weight = 7.5f;
		jewelA.hasStone = true;
		jewelA.gold.stone = st;
		jewelA.gold.stone.type = "diamond";

		jewelB.metal = "silver";
		jewelB.type = "chain";
		jewelB.size = 'L';
		jewelB.silver = s;
		jewelB.silver.price = 10000;
		jewelB.silver.weight = 52.0f;
		jewelB.hasStone = false;
		
		
		System.out.println(jewelA.metal + " " + jewelA.type + " "
				+ jewelA.size + " " + jewelA.gold.price + " "
				+ jewelA.gold.weight + " " + jewelA.hasStone + " "
				+ jewelA.gold.stone.type);
		
		System.out.println(jewelB.metal + " " + jewelB.type + " "
				+ jewelB.size + " " + jewelB.silver.price + " "
				+ jewelB.silver.weight + " " + jewelB.hasStone);
	}

}
