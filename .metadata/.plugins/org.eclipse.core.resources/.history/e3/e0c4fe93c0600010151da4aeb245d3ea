						j > 1 && j < 6 && i == 6)
						System.out.print("*");
					else
						System.out.print(" ");
				System.out.println();
			}
			
			break;
		case 'v' :
		case 'V' :
			for (int i = 1; i <= 6; i++) {
				for (int j = 1; j <= 12; j++)
					if (j == i || j == 12 - i)
						System.out.print("*");
					else
