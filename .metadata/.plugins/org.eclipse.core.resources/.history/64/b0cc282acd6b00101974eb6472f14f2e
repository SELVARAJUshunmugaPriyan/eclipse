	@Override
	List<Integer> singleAmongDoubles(int[] arr, boolean callSuper)
	{
		if (callSuper)
			return super.singleAmongDoubles(arr, callSuper);
			
		if (DEBUG) System.out.printf("In singleAmongDoubles(int[]=%s,bl=%s)\n", 
				   Arrays.toString(arr), callSuper);
		
