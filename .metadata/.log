		static void print(DigitNode head)
		{
			if (head == null)
				return;
			print(head.next);
			System.out.print(head.digit);
		}
		
		static void multiply(DigitNode head, int i)
		{
			DigitNode temp = head;
			DigitNode prev = head;
			int carry = 0;
			
			while (temp != null) {
				int prod = temp.digit * i + carry;
				temp.digit = prod % 10;
				carry = prod / 10;
				prev = temp;
				temp = temp.next;
			}
			
			while (carry > 0) {
