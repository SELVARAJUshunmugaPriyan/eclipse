class Fruit
{
	String color, taste;
	boolean isRipe;
}

class Mango extends Fruit
{
	int price, quantity;
	String type;
}

class Orange extends Fruit
{
	int price, quantity;
	String type;
}

public class UseFruit 
{

	public static void main(String[] args) 
	{
		// TODO Auto-generated method stub
		Fruit f = new Fruit();
		
		f.color = "green";
		f.taste = "sour";
		f.isRipe = true;
		
		System.out.println(f.getClass().toString().split("\\.")[1]
				+ " " + f.taste + " "
				+ f.color + " " + (f.isRipe ? "Ready to eat" : 
					"Not ready to eat"));
		
		Mango m = new Mango();
		
		m.color = "yellow";
		m.taste = "sweet";
		m.isRipe = false;
		m.price = 200;
		m.quantity = 5;
		m.type = "Alphonsa";
		
		System.out.println(m.getClass().toString().split("\\.")[1]
				+ " " + m.taste + " "
				+ m.color + " " + (m.isRipe ? "Ready to eat" : 
				"Not ready to eat") + " " + m.price + " " 
				+ m.quantity + "kg " + m.type);
		
		Orange o = new Orange();
		
		o.color = "orange";
		o.taste = "tangy";
		o.isRipe = true;
		o.price = 150;
		o.quantity = 6;
		o.type = "Clementine";
		
		System.out.println(o.getClass().toString().split("\\.")[1]
				+ " " + o.taste + " "
				+ o.color + " " + (o.isRipe ? "Ready to eat" : 
				"Not ready to eat") + " " + o.price + " " 
				+ o.quantity + "kg " + o.type);
	}

}