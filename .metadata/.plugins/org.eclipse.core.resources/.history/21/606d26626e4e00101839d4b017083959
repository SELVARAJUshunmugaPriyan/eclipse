class Employee
{
	private int id, salary;
	private String name, company;
	
	// Constructors
	public Employee(int id, int salary,
			String name, String company)
	{
		this.id = id;
		this.salary = salary;
		this.name = name;
		this.company = company;
	}
	
	// Getters
	public String toString()
	{
		return id + " " + name + " "
			 + company + " " + salary;
	}
}

class SoftwareEngineer extends Employee
{
	private String team, domain, role;
	
	// Constructors
	public SoftwareEngineer(int id, int salary,	String name,
			String company, String team, String domain, String role)
	{
		super(id, salary, name, company);
		this.team = team;
		this.domain = domain;
		this.role = role;
	}
	
	// Getters
	public String toString()
	{
		return super.toString() + " " + team + " "
			 + " " + domain + " " + role;
	}
}

class Engineer extends SoftwareEngineer
{
	String qualification, experience;
	boolean isServingNoticePeriod;
	
	// Constructors
	public Engineer(int id, int salary,	String name,
			String company, String team, String domain, String role,
			String qualification, String experience, boolean isServingNoticPeriod)
	{
		super(id, salary, name, company, team, domain, role);
		this.qualification = qualification;
		this.experience = experience;
		this.isServingNoticePeriod = isServingNoticPeriod;
	}
}

public class UseEngineer 
{

	public static void main(String[] args) 
	{
		// TODO Auto-generated method stub
		
		Employee e = new Employee(1001, 25000, "Preethi", "HCL");
		
		System.out.println(e);
		
		SoftwareEngineer s = new SoftwareEngineer(1002, 42000,
				"Sruthi", "CTS", "Database maintenance",
				"Oracle SQL", "Administrator");
		
		System.out.println(s);
		
		Engineer f = new Engineer(1003, 36000, "Mahesh", "TCS",
				"Devops", "CI/CD", "Technical support", "B.E.",
				"2.5 yrs", false);
		
		System.out.println(f.id + " | " + f.name + " | "
				+ f.company + " | " + f.salary + " | "
				+ f.team + " | " + f.domain + " | " + f.role
				+ f.qualification + " | " + f.experience + " | "
				+ (f.isServingNoticePeriod ? 
						"Serving notice" : "Not service notice"));
		
	}

}