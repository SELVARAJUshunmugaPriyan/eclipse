		Integer sum[] = new Integer[Math.max(arrA.length, arrB.length)];
		BiFunction<Integer[], Integer, Integer> 
			getOrDefault = (arr, i) -> {
				Integer x;
				try {
					x = arr[i];
				} catch (ArrayIndexOutOfBoundsException e) {
					x = 0;
				}
				return x;
			};
		
		for (int i = 0; i < sum.length; i++)
			sum[i] = getOrDefault.apply(arrA, i) + getOrDefault.apply(arrB, i);
		
		return sum;
	}
	
	private static int[] sumOfPolynomials(int[] arrA, int[] arrB)
	{
		if (DEBUG) System.out.printf("In sumOfPolynomials(int=%s,int=%s)\n",
