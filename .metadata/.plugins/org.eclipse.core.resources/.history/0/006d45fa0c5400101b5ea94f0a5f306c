// Java class to demonstrate conversion
// of array to ArrayList
class ConvertArray2ArrayList
{
	// Using stream().boxed().collect()
	ConvertArray2ArrayList()
	{
		// Creating an integer array
		int I[] = javaArrayExcercises.BubbleSort.getRandomArray(
				  					new Scanner(System.in));

		// Printing the array and its type
		System.out.println(Arrays.toString(I) + " is of "
				+ "type " + I.getClass());
		
		// Converting the array into List
		List<Integer> al = Arrays.stream(I).boxed().collect(
									Collectors.toList());

		// Printing the List and its type
		System.out.println(al + " is of type " + al.getClass());
	}
	
	// Function to demonstrate error
	// if we add more element(s) to
	// a fixed-size ArrayList
	@SuppressWarnings({"unchecked", "rawtypes"})
	static void usingAsListFixed()
	{
		String[] geeks = {"Keerthana", "Priyan"};
		
		// Conversion of array to ArrayList
		// using asList()
		List al = Arrays.asList(geeks);
		System.out.println(al);
		
		try {
			// Adding more values to the list
			al.add("Shunmuga"); // Error
		} catch (Exception e) {
			System.out.println(e);
		}
		
		System.out.println(al);
	}
	
	// Function to demonstrate how to add
	// one or more element(s) to returned
	// resizable List.
	static void usingAsListResizable()
	{
		String[] geeks = {"Keerthana", "Priyan"};
		List<String> al = new ArrayList<String>(
										Arrays.asList(geeks));
		
		// Adding more elements to the list
		al.add(1, "Shunmuga");
		
		System.out.println("\nArrayList after adding one "
				+ "more element: " + al);
	}
	
	// Function to demonstrate how to add
	// all element(s) to ArrayList.
	static void usingAddAll()
	{
		String[] geeks = {"Keerthana", "Priyan"};
		List<String> al = new ArrayList<String>();
		
		// Adding elements of array to ArrayList
		Collections.addAll(al, geeks);
//		Collections.addAll(null, geeks); // Error
//		Collections.addAll(al, null); // Error
		
		System.out.println(al);
	}
	
	// Function to convert array to ArrayList
	// using add() in a loop
	static void usingAdd()
	{
		String[] geeks = {"Keerthana", "Priyan"};
		List<String> al = new ArrayList<String>();
		
		// array to ArrayList conversion
		for (String s : geeks)
			al.add(s);
		
		System.out.println(al);
	}
}

//Java class to demonstrate conversion
//of List to Set
class ConvertList2Set
{
	// Using simple traversal
	static void usingTraversal()
	{
		// Creating a List
		List<String> list = Arrays.asList("Hi,", "this", "is", "my",
									   "world");
		
		Set<String> hSet = new HashSet<>();
		
		for(String s : list)
			hSet.add(s);	
		
		System.out.println("Created HashSet : " + hSet);
		
		Set<String> tSet = new TreeSet<>();
		
		for(String s : list)
			tSet.add(s);
		
		System.out.println("Created TreeSet : " + tSet);
	}
	
	// Using Constructors
	static void usingConstructors()
	{
		// Creating a List
		List<String> list = Arrays.asList("Hi,", "this", "is", "my",
									   "world");
		
		Set<String> hSet = new HashSet<>(list);		
		System.out.println("Created HashSet : " + hSet);
		
		Set<String> tSet = new TreeSet<>(list);
		System.out.println("Created TreeSet : " + tSet);
	}
	
	// Using AddAll
	static void usingAddAll()
	{
		// Creating a List
		List<String> list = Arrays.asList("Hi,", "this", "is", "my",
									   "world");
		
		Set<String> hSet = new HashSet<>(list);
		hSet.addAll(list);
		System.out.println("Created HashSet : " + hSet);
		
		Set<String> tSet = new TreeSet<>(list);
		tSet.addAll(list);
		System.out.println("Created TreeSet : " + tSet);
	}
	
	// Using stream
	static void usingStream()
	{
		// Creating a List
		List<String> list = Arrays.asList("Hi,", "this", "is", "my",
									   "world");
		
		Set<String> set = list.stream().collect(
										 Collectors.toSet());
		System.out.println("Created HashSet : " + set);
	}
}

