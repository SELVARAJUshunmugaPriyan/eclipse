	private static int missingNumber(int[] arr)
	{
		if (DEBUG) System.out.printf("In missingNumber(int[]=%s)\n", 
				   Arrays.toString(arr));
		
		int n = arr.length + 1, sum = (int) ((n + 1) * n / 2.0);
		
		for (int i : arr)
			sum -= i;
		
		return sum;
	}
	
