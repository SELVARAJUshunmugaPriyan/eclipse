	private static void letter(int c)
	{
		if (DEBUG) System.out.printf("In letter(int=%c)\n", c);
		System.out.println("Letter pattern : ");
		
		switch (c) {
		case 'a' :
		case 'A' :
			for (int i = 1; i <= 6; i++) {
				for (int j = 1; j <= 12; j++)
					if (j == 7 - i || j == 6 + i ||
						(i == 4 && j >= 7 - i && j <= 6 + i))
						System.out.print("*");
					else
						System.out.print(" ");
				System.out.println();
			}
			
			break;
		case 'b' :
		case 'B' :
			for (int i = 1; i <= 6; i++) {
				for (int j = 1; j <= 6; j++)
					if (j == 1 || j < 6 && (i == 1 || i == 6 || i == 3) ||
						j == 6 && (i == 2 || i == 4 || i == 5))
						System.out.print("*");
					else
						System.out.print(" ");
				System.out.println();
			}
			
			break;
		case 'c' :
		case 'C' :
			for (int i = 1; i <= 6; i++) {
				for (int j = 1; j <= 6; j++)
					if (j == 1 && (i > 2 && i < 5) || j > 1 && (i == 1 || i == 6) || 
						(j == 1 || j == 2) && (i == 2 || i == 5))
						System.out.print("*");
					else
						System.out.print(" ");
				System.out.println();
			}
			
			break;
		case 'd' :
		case 'D' :
			for (int i = 1; i <= 6; i++) {
				for (int j = 1; j <= 6; j++)
					if (j == 1 || j < 6 && (i == 1 || i == 6) || 
						j == 5 && (i == 2 || i == 5) || 
						j == 6 && (i > 1 && i < 6))
						System.out.print("*");
					else
						System.out.print(" ");
				System.out.println();
			}
			
			break;
		case 'e' :
		case 'E' :
			for (int i = 1; i <= 6; i++) {
				for (int j = 1; j <= 6; j++)
					if (j == 1 || i == 1 || i == 6 || i == 3)
						System.out.print("*");
					else
						System.out.print(" ");
				System.out.println();
			}
			
			break;
		case 'f' :
		case 'F' :
			for (int i = 1; i <= 6; i++) {
				for (int j = 1; j <= 6; j++)
					if (j == 1 || i == 1 || i == 3)
						System.out.print("*");
					else
						System.out.print(" ");
				System.out.println();
			}
			
			break;
		case 'g' :
		case 'G' :
			for (int i = 1; i <= 6; i++) {
				for (int j = 1; j <= 6; j++)
					if (j == 1 && (i > 2 && i < 5) || 
						j > 1 && j < 6 && (i == 6 || i == 1) || 
						(j == 1 || j == 2) && (i == 2 || i == 5) ||
						(j == 6 && i > 3 && i < 6) || (j > 3 && i == 3))
						System.out.print("*");
					else
						System.out.print(" ");
				System.out.println();
			}
			
			break;
		case 'h' :
		case 'H' :
			for (int i = 1; i <= 6; i++) {
				for (int j = 1; j <= 6; j++)
					if (j == 1 || j == 6 || i == 3)
						System.out.print("*");
					else
						System.out.print(" ");
				System.out.println();
			}
			
			break;
		case 'i' :
		case 'I' :
			for (int i = 1; i <= 6; i++) {
				for (int j = 1; j <= 6; j++)
					if (j == 3 || j > 1 && j < 5 && (i == 1 || i == 6))
						System.out.print("*");
					else
						System.out.print(" ");
				System.out.println();
			}
			
			break;
		case 'j' :
		case 'J' :
			for (int i = 1; i <= 6; i++) {
				for (int j = 1; j <= 6; j++)
					if (i == 1 || j == 4 && i < 6 ||
						(j == 2 || j == 3) && i == 6 ||
						j == 1 && i == 5)
						System.out.print("*");
					else
						System.out.print(" ");
				System.out.println();
			}
			
			break;
		case 'k' :
