package forTwo;

public class UseCar {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Car car1 = new Car();
		Car car2 = new Car();
		Car car3 = new Car();
		Car car4 = new Car();
		Car car5 = new Car();
		
		Car[] cars = {car1, car2, car3, car4, car5};
		
		car1.brand = "Hyundai";
		car1.color = "blue";
		car1.size = 'S';
		car1.price = 400000;
		car1.isQuality = true;
		
		car2.brand = "Toyota";
		car2.color = "yellow";
		car2.size = 'L';
		car2.price = 700000;
		car2.isQuality = true;
		
		car3.brand = "Kia";
		car3.color = "red";
		car3.size = 'S';
		car3.price = 500000;
		car3.isQuality = false;
		
		car4.brand = "Ford";
		car4.color = "green";
		car4.size = 'M';
		car4.price = 900000;
		car4.isQuality = true;
		
		car5.brand = "Volvo";
		car5.color = "black";
		car5.size = 'S';
		car5.price = 450000;
		car5.isQuality = true;
		
		for(int i = 0; i < cars.length; i++)
			System.out.println(cars[i].brand + " " + cars[i].color + " " + cars[i].size + " " + cars[i].price + " " + cars[i].isQuality);
		
		System.out.println();
		
		for(Car car : cars)
			if(car.brand.length() % 2 == 0)
				System.out.println(car.brand);
		
		System.out.println();
		
//		Car maxCar = new Car();
		Car maxCar = car1;
		
		for(Car car : cars)
			if(car.price > maxCar.price)
				maxCar = car;
		
		System.out.println(maxCar.brand + " " + maxCar.color + " " + maxCar.size + " " + maxCar.price + " " + maxCar.isQuality + "\n");

		int amt = 0;
		
		for(Car car: cars)
			amt += car.price;
		
		System.out.println("Total amount: " + amt + "\n");
		
		for(Car car: cars)
			System.out.println("Last character of color is " + car.color.charAt(car.color.length() - 1));
		
		System.out.println();
		
		for(int i = 0; i < cars.length; i++)
			if(cars[i].price >= 100000 && cars[i].price <= 500000)
				System.out.println(cars[i].brand + " " + cars[i].color + " " + cars[i].size + " " + cars[i].price + " " + cars[i].isQuality);
	}

}

class Car {
	String brand, color;
	char size;
	int price;
	boolean isQuality;
}