package forTwo;

public class LoopsOddStringEvenString {
	public static void main(String[] args) {
		String[] sa = {"Hello", "Worlds", "doggy", "dolly"};
		
		for(int i = 0; i < sa.length; i++)
			if(sa[i].length() % 2 == 0)
				System.out.print("Even:" + sa[i]);
		System.out.println();
		for(int i = 0; i < sa.length; i++)
			if(sa[i].length() % 2 == 1)
				System.out.print("Odd:" + sa[i]);
	}
}
