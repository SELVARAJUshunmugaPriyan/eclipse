			for (int i = 0; i <= 6; i++) {
				double dist = 0;
				for (int j = 0; j <= 6; j++) {
					dist = Math.sqrt((i - 3) * (i - 3) +
									 (j - 3) * (j - 3));
					if (dist >= 2.5 && dist <= 3.5 || j == i && i > 3)
						System.out.print("*");
