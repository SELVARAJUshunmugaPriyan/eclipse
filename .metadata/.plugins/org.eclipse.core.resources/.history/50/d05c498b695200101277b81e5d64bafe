class AnotherClassExtends extends OuterClass
{
	
	public static void main(String[] args)
	{
//		OuterClass.PrivateInnerClass inner = new OuterClass().
//				new PrivateInnerClass(); // Error
		new AnotherClassExtends() // Access to protected inner class after
			.new ProtectedInnerClass() // extending through subclass
			.displayInnerData(); // object
		
		new OuterClass() // Access to protected inner class after
			.new ProtectedInnerClass() // extending through parent class
			.displayInnerData(); // object
		
		// Only public and protected (through subclass)
		// fields are accessible
//		new OuterClass().defaultData = 0; // Error
		new OuterClass().publicData = 0;
//		new OuterClass().protectedData = 0; // Error through parent object
//		new OuterClass().privateData = 0; // Error
		new AnotherClassExtends().protectedData = 0;
//		new AnotherClassExtends().defaultData = 0; // Error
		new AnotherClassExtends().publicData = 0;
//		new AnotherClass().privateData = 0; // Error
		
		// public and protected (for subclass) methods
		// are accessible
//		new OuterClass().defaultMethod(); // Error
		new OuterClass().publicMethod();
//		new OuterClass().protectedMethod(); // Error
//		new OuterClass().privateMethod(); // Error
//		new AnotherClassExtends().defaultMethod(); // Error
		new AnotherClassExtends().publicMethod();
		new AnotherClassExtends().protectedMethod();
//		new AnotherClassExtends().privateMethod(); // Error
		
		// public and protected inner classes are accessible
		// NOTE : protected inner class was not accessible for 
		// 		  parent object without extending. Even after 
		// 		  extending methods and fields are not accessible
		//		  for parent object
//		new OuterClass().new DefaultInnerClass();
		new OuterClass().new PublicInnerClass();
		new OuterClass().new ProtectedInnerClass();
//		new OuterClass().new PrivateInnerClass(); // Error
//		new AnotherClassExtends().new DefaultInnerClass();
		new AnotherClassExtends().new PublicInnerClass();
		new AnotherClassExtends().new ProtectedInnerClass();
//		new AnotherClassExtends().new PrivateInnerClass(); // Error
		
		AnotherClassExtends.staticProtectedMethod();
		OuterClass.staticProtectedMethod();
		staticProtectedMethod();
	}
}