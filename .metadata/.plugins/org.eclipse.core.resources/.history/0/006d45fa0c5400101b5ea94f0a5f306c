class ConvertHashMap2TreeMap
{
	ConvertHashMap2TreeMap()
	{
		Map<Integer, Integer> hMap = new HashMap<>();
		Map<Integer, Integer> tMap = new TreeMap<>();
		
		hMap.put(0, 1);
		hMap.put(1, 2);
		hMap.put(2, 3);
		hMap.put(3, 4);
		
		// Using addAll
//		tMap.putAll(hMap);
		
		// Bulk copying using forEach
		hMap.forEach((k, v) -> tMap.put(k, v));
		
		System.out.println("Tree map : " + tMap);
	}
	
//	@SuppressWarnings("rawtypes")
	static <K, V> Map<K, V> convertUsingPutAll(
			Map<K, V> hMap)
	{
		Map<K, V> tMap = new TreeMap<>();
		tMap.putAll(hMap);
		return tMap;
	}
	
	public static void main(String[] args)
	{
		Map<Integer, Integer> hMap = new HashMap<>();
		
		hMap.put(0, 1);
		hMap.put(1, 2);
		hMap.put(2, 3);
		hMap.put(3, 4);
		
		Map<Integer, Integer> tMap = convertUsingPutAll(hMap);
		
		System.out.println(tMap);
	}
}