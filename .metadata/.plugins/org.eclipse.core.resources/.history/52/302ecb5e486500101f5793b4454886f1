	private static void recurPermuatations(int index, StringBuilder str, List<String> ans)
	{
		if (index == str.length()) {
			ans.add(str.toString());
			return;
		}
		
		for (int i = index; i < str.length(); i++) {
			swap(str, index, i);
			if (DEBUG) System.out.println(str.toString());
			recurPermuatations(index + 1, str, ans);
			swap(str, index, i);
		}
	}
	
	private static void swap(StringBuilder str, int i, int j)
	{
		char temp = str.charAt(i);
		str.setCharAt(i, str.charAt(j));
		str.setCharAt(j, temp);
	}
	
	private static void genPermutations(int i, StringBuilder s, boolean used[],
			String str, Set<String> set)
	{
		if (i == str.length()) {
			set.add(s.toString());
			return;
		}
		
		for (int j = 0; j < str.length(); j++)
			if (!used[j]) {
				
				used[j] = true;
				s.append(str.charAt(j));
				
				if (DEBUG) System.out.println(s.toString());
				
				genPermutations(i + 1, s, used, str, set);
				
				used[j] = false;
				s.deleteCharAt(i);
			}
	}
	
	private static void genPermutations(int n, StringBuilder s, Map<Character, Integer> cnt,
										List<String> ans)
	{
		if (s.length() == cnt.keySet().size()) {
			ans.add(s.toString());
			return;
		}
		
		for (Map.Entry<Character, Integer> entry : cnt.entrySet()) {
			
			char c = entry.getKey();
			int count = entry.getValue();
			
			if (count == 0)
				continue;
			
			s.append(c);
			cnt.put(c, 0);
			
			genPermutations(n, s, cnt, ans);
			
			cnt.put(c, count);
			s.deleteCharAt(s.length() - 1);
		}
	}
	
	private static boolean carmichaelNumber(int n)
	{
		if (DEBUG) System.out.printf("In carmichaelNumber(int=%d)\n", n);
		
		Recur<BiFunction<Integer, Integer, Integer>> gcd = new Recur<>();
		gcd.func = (x, y) -> {
			if (x == 0)
				return y;
			return gcd.func.apply(y % x, x);
		};
		
		for (int i = 2; i < n; i++)
			if (gcd.func.apply(n, i) == 1 && power(i, n - 1, n) != 1)
				return false;
		
		return true;
	}
	
	static int power(int x, int y, int m)
	{
		if (y == 0)
			return 1;
		int temp = power(x, y / 2, m);
		temp = (temp * temp) % m;
		if (y % 2 == 1)
			temp = (temp * x) % m;
		return temp;
	}
	
	static List<Integer> collatzSequence(Integer n, List<Integer> res)
	{
		if (DEBUG) System.out.printf("In collatzSequence(Int=%d,L<I>=%s)\n", n, res);
		
		res.add(n);
		
		if (n == 1) {
			return res;
		}
		
		return collatzSequence(( n % 2 == 0 ? n / 2 : (3 * n + 1) ), res);
	}
	
	static void collatzSequence(int n)
	{
		if (DEBUG) System.out.printf("In collatzSequence(int=%d)\n", n);
		
		while (n != 1) {
			System.out.print(n + " ");
			
			if (n % 2 == 0)
				n /= 2;
			else {
				n *= 3;
				n++;
			}
		}
		
		System.out.println(n);
	}
	
	private static int gridUniqPathsCount(Integer i, Integer j, Integer n, Integer m)
	{
		if (DEBUG) System.out.printf("In gridUniqPathsCount(Int=%d,Int=%d,Int=%d,Int=%d)\n",
				i, j, n, m);
		if (i == n - 1 && j == m - 1)
			return 1;
		else if (i > n - 1 || j > m - 1)
			return 0;
		
		return gridUniqPathsCount(i + 1, j, n, m) + gridUniqPathsCount(i, j + 1, n, m);
	}
	
