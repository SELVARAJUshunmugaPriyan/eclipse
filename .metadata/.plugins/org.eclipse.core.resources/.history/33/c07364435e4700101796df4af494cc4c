package javaArrayExcercises;

import java.util.Arrays;
import java.util.NoSuchElementException;
import java.util.Scanner;

class ArrayOrderMismatchException extends Exception {

	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;
	
	public ArrayOrderMismatchException(String msg) {
		super(msg);
	}
}

public class ArraySum {
	
	public static int[][] sumOfMatrix(int[][] I, int[][] J) {
		int sum[][] = new int[I.length][];
		for(int i = 0; i < I.length; i++) {
			int ARR[] = new int[I[i].length];
			for(int j = 0; j < I[i].length; j++)
				ARR[j] = I[i][j] + J[i][j];
			sum[i] = ARR;
		}
		
		return sum;
	}
	
	public static void arrayOrderEquals(int[][] I, int[][] J) throws ArrayOrderMismatchException {		
		if(I.length != J.length)
			// Detecting rows mismatch
			throw new ArrayOrderMismatchException(null);
		
		for(int i = 0; i < I.length; i++)
			if(I[i].length != J[i].length)
				// Detecting columns mismatch
				throw new ArrayOrderMismatchException(null);
		
		return;
	}
	
	public static int[][] receiveMatrix(Scanner scn) {
		int i = 0, j = 0, n = 0;
		
		System.out.println("Enter array in following format:"
				+ "\n[[num1, num2, num3], or [num1, num2, num3]"
				+ "\n [num1, num2, num3],"
				+ "\n [num1, num2, num3]]");
		
		String[] S = scn.nextLine().split("\\], \\[");
		n = S.length;
		int[][] I = new int[n][];
		
		for(String s : S) {
			String[] T = s.split(",");
			int[] K = new int[T.length];
			j = 0;
			// Parsing the matrix
			for(String t : T) {
				if(t.indexOf("[[") == 0)
					 // Removing "[["
					t = t.substring(2);
				if(t.indexOf("]]") == t.length() - 2 && t.indexOf("]]") > 0)
					 // Removing "]]"
					t = t.substring(0, t.length() - 2);
				if(t.indexOf("[") == 0)
					 // Removing "["
					t = t.substring(1);
				if(t.indexOf("]") == t.length() - 1 && t.indexOf("]") > 0)
					 // Removing "]"
					t = t.substring(0, t.length() - 1);
				
				K[j++] = Integer.parseInt(t.trim());
			}
			I[i++] = K;
		}
		
		return I;
	}

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner scn = new Scanner(System.in);
		Print2DMatrixThree prnt = new Print2DMatrixThree();
		
		try {
			
			while(true) {
				try {
					System.out.print("First: ");
					int[][] I  = receiveMatrix(scn);
					System.out.print("Second: ");
					int[][] J = receiveMatrix(scn);
					
					arrayOrderEquals(I, J);
					
					System.out.println("Sum of two arrays is\n"
							+ prnt.print2D(sumOfMatrix(I, J)));
				} catch(NumberFormatException e) {
					System.out.println("Only numbers are accepted");
				} catch(ArrayOrderMismatchException e) {
					System.out.println("Only matrices of same order are accepted");
				}
			}
			
		} catch(NoSuchElementException e) {
			;
		} finally {
			System.out.println("Closing System in resource");
			scn.close();
		}

	}

}
