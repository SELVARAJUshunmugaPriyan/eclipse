	{			
		if (DEBUG) System.out.printf("In singleRepeat(int[]=%s,neg)\n",
						Arrays.toString(arr));
		
		for (int i : arr)
			if (arr[Math.abs(i) - 1] < 0)
				return Math.abs(i);
			else
				arr[Math.abs(i) - 1] = -arr[Math.abs(i) - 1];
		
