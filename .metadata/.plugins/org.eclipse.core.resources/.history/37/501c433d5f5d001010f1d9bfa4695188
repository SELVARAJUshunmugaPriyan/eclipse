	private static int squaresInRectangle(float m, float n)
	{
		if (DEBUG) System.out.printf("In squaresInRectangle(flt=%.0f, flt=%.0f)\n", m, n);
		int count = 0;
		for (int i = 1; i <= Math.min(m, n); i++)
			count += (m - i + 1) * (n - i + 1);
		
		return count;
	}
	
	private static int squaresInRectangle(int m, int n)
	{
		if (DEBUG) System.out.printf("In squaresInRectangle(int=%d, int=%d)\n", m, n);
		if (m == n)
			return (n * (n + 1) * (2 * n + 1)) / 6;
		
		if (m > n) {
			int temp = m;
			m = n;
			n = temp;
		}
		
		return (m * (m + 1) * (2 * m + 1)) / 6 +
			   ((n - m) * m * (m + 1)) / 2;
	}
	
	private static boolean isValidChessBd(Float[][] chess)
	{
		Float squareWhite = chess[0][0];
		Float squareBlack = chess[0][1];
		
		if (squareWhite == squareBlack)
			return false;
		
		for (int i = 0; i < chess.length; i++) {
			Float row[] = chess[i];
			
			if (row.length != chess.length)
				return false;
			
			if (i < chess.length - 1 			      && 
				!((chess[i][0] != squareWhite	  && 
				   chess[i][0] != squareBlack)    	||
			      (chess[i + 1][0] != squareWhite && 
				   chess[i + 1][0] != squareBlack)))
				if (chess[i][0] == chess[i + 1][0])
					return false;
			
			for (int j = 0; j < row.length - 1; j++) {
				if (!(row[j] != squareWhite     &&
					  row[j] != squareBlack)      ||
				    !(row[j + 1] != squareWhite && 
					  row[j + 1] != squareBlack))
					if (row[j] == row[j + 1])
						return false;
			}
		}
		return true;
	}
	
