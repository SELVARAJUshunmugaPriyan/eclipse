package forThree;

public class WhileNumberPalindrome {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int N = 1111, i = 0;
		int[] I = new int[(int) Math.log10(N) + 1];
		boolean isPalindrome = true;
		
		while(N > 0) {
			I[i++] = N % 10;
			N /= 10;
		}
		
		i = 0;
		while(i < I.length)
			if(I[i] != I[I.length - 1 - i++])
				isPalindrome = false;
		
		if(isPalindrome)
			System.out.print(N + " is palindrome");
		else
			System.out.print(N + " is not palindrome");
	}

}
