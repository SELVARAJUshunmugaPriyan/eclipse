package solution;

public class SolutionAmstrongNumber {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int i = 153;
		
		if(amstrongNum(i))
			System.out.print(i + " is a Amstrong number");
		else
			System.out.print(i + " is not a Amstrong number");
	}
	
	public static boolean amstrongNum(int num) {
		int n = (int) Math.log10(num) + 1, sum = 0;
		
		for(int i = 1; i <= n; i++) {
			int r = (num % (int) Math.pow(10, i)) / (int) Math.pow(10, i - 1);
			sum += Math.pow(r, n);
			System.out.println(r + " " + sum);
		}
		return false;
	}

}

