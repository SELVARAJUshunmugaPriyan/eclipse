	private static int[] multiplyIntArr(int[] arr, int x)
	{
		if (DEBUG) System.out.printf("In multiplyIntArr(int[]=%s,int=%d)\n",
							Arrays.toString(arr), x);
		
		int carry = 0, res[] = new int[arr.length];
		
		for (int i = arr.length - 1; i >= 0; i--) {
			int pdt = arr[i] * x + carry;
			carry = pdt / 10;
			res[i + (res.length - arr.length)] = pdt % 10;
