package javaArrayExcercises;

import java.util.Arrays;
import java.util.NoSuchElementException;
import java.util.Scanner;

public class InsertionSort 
{
	static void insertionSort(int arr[])
	{
		int n = arr.length;
		
		for (int i = 1; i < n; i++) {
			int k = arr[i], j = i - 1;
			System.out.println("i=" + i + ", k=" + k 
					+ ", j=" + j + ", arr[j]=" + arr[j]);
			// Move elements of arr[0..i-1], that are
			// greater than key, to one position ahead
			// of their current position
			while (j >= 0  && arr[j] > k) {
				arr[j + 1] = arr[j];
				j--;
				System.out.println("j=" + j + " " 
						+ "arr[j]=" + ((j < 0) ? " " : arr[j]) + " "
						+ Arrays.toString(arr));
			}
		
			arr[j + 1] = k;
			System.out.println("\n" + Arrays.toString(arr) + "\n");
		}
	}
	
	public static void main(String[] args) 
	{
		// TODO Auto-generated method stub
		Scanner scn = new Scanner(System.in);
		
		try {
			while(true) {
				try {
//					int I[] = BubbleSort.getArray(scn);
					int I[] = BubbleSort.getRandomArray(scn);
					
					System.out.println("The generated array is "
							+ Arrays.toString(I));
					
					long timeElapsed = System.nanoTime();
					
					insertionSort(I);
					
					timeElapsed = System.nanoTime() - timeElapsed;
					
					System.out.println("The sorted array is "
							+ Arrays.toString(I) 
							+ "\nElapsed time: " + timeElapsed);
					
				} catch(NumberFormatException e) {
					System.out.println("Only integers are accepted");
				} catch(StringIndexOutOfBoundsException e) {
					;
				}
			}
			
		} catch(NoSuchElementException e) {
			;
		} finally {
			System.out.println("Closing System in resource");
			scn.close();
		}

	}

}
