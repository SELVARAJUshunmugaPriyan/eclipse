	private static List<String> findPermutations(String str)
	{
		if (DEBUG) System.out.printf("In findPermutations(Str=%s)\n", str);
		
		StringBuilder s = new StringBuilder(str);
		List<String> ans = new ArrayList<>();
		
		recurPermuatations(0, s, ans);
		
		return ans;
	}
	
	private static void recurPermuatations(int index, StringBuilder str, List<String> ans)
	{
		if (index == str.length()) {
			ans.add(str.toString());
			return;
		}
		
		for (int i = index; i < str.length(); i++) {
			swap(str, index, i);
			recurPermuatations(index + 1, str, ans);
			swap(str, index, i);
		}
	}
	
