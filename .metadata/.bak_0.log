		for (int i = 0; i < n - m; i++)
			lstB.add(0);
		
		for (int i = 0; i < m - n; i++)
			lstA.add(0);
		
		Iterator<Integer> itr = lstA.iterator();
		
		return lstB.stream()
				   .map(x -> x + itr.next())
				   .toList();
	}
	
