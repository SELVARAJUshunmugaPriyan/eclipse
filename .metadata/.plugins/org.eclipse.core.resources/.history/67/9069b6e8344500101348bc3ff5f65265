package lms;

public class SolutionStringReverseEach {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		for(String s : args[0].split(",")) {
			char[] C = s.toCharArray();
			
			for(int i = C.length - 1; i >= 0; i--)
				System.out.print(C[i]);
			
			System.out.print(" ");
		}
	}

}
