package oopsTwo;

class Employee
{
	int id, salary;
	String name, company;
}

class SoftwareEngineer extends Employee
{
	String team, domain, role;
}

class Engineer extends SoftwareEngineer
{
	String qualification, experience;
	boolean isServingNoticePeriod;
}

public class UseEngineer 
{

	public static void main(String[] args) 
	{
		// TODO Auto-generated method stub
		
		Employee e = new Employee();
		
		e.company = "HCL";
		e.id = 1001;
		e.name = "Preethi";
		e.salary = 25000;
		
		System.out.println(e.id + " " + e.name + " "
				+ e.company + " " + e.salary);
		
		SoftwareEngineer s = new SoftwareEngineer();
		
		s.company = "CTS";
		s.id = 1002;
		s.name = "Sruthi";
		s.salary = 42000;
		s.team = "Database maintenance";
		s.domain = "Oracle SQL";
		s.role = "Administrator";
		
		System.out.println(s.id + " " + s.name + " "
				+ s.company + " " + s.salary + " "
				+ s.team + " " + s.domain + " " + s.role);
		
		Engineer f = new Engineer();
		
		f.company = "TCS";
		f.id = 1003;
		f.name = "Mahesh";
		f.salary = 36000;
		f.team = "Devops";
		f.domain = "CI/CD";
		f.role = "Technical support";
		f.qualification = "B.E.";
		f.experience = "2.5 yrs";
		f.isServingNoticePeriod = false;
		
		System.out.println(f.id + " " + f.name + " "
				+ f.company + " " + f.salary + " "
				+ f.team + " " + f.domain + " " + f.role
				+ f.qualification + " " + f.experience
				+ (f.isServingNoticePeriod ? 
						"Serving notice" : "Not service notice"));
		
	}

}
