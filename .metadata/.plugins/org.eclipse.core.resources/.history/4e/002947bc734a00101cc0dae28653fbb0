		AC a = new AC();
		
		a.setColor("white");
		a.setPrice(12000);
		a.setCompressor(new Compressor());
		a.getCompressor().setBrand("NEXO");
		a.getCompressor().setCapacity(1200);
		
		System.out.print(a.getColor() + " " + a.getPrice()
				+ " " + a.getCompressor().getBrand()
				+ " " + a.getCompressor().getCapacity());
	}

}
