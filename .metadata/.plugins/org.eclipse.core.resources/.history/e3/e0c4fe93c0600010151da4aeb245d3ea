	private static void characterBridge(Integer n)
	{
		if (DEBUG) System.out.printf("In characterBridge(Int=%d)\n", n);
		
		for (int i = n; i >= 1; i--) {
			char letter = '@';
			for (int j = 1; j <= i; j++)
				System.out.print(++letter);
			
			if (i != n)
				letter++;
			
			for (int j = 1; j < 2 * (n - i); j++)
				System.out.print(" ");
			
			for (int j = 1; j <= i; j++) {
				if (j == n)
					continue;
				System.out.print(--letter);
			}
			
			System.out.println();
		}
	}
	
	private static void characterBridge(int n)
	{
		if (DEBUG) System.out.printf("In characterBridge(int=%d)\n", n);
		
		for (int i = 0; i < n; i++) {
			for (int j = 'A'; j < 'A' + 2 * n - 1; j++)
				if (j >= 'A' + n - 1 + i)
					System.out.print((char) ('A' + n - 1 - j % ('A' + n - 1)));
				else if (j <= 'A' + n - 1 - i)
					System.out.print((char) j);
				else
					System.out.print(" ");
			
			System.out.println();
		}
	}
	
	private static void invertedV(Integer n)
	{
		if (DEBUG) System.out.printf("In invertedV(Int=%d)\n", n);
		
		for (int i = 0; i < n; i++) {
			for (int j = 'A'; j < 'A' + 2 * n - 1; j++)
				if (j == 'A' + n - 1 + i)
					System.out.print((char) ('A' + n - 1 - j % ('A' + n - 1)));
				else if (j == 'A' + n - 1 - i)
					System.out.print((char) j);
				else
					System.out.print(" ");
			
			System.out.println();
		}
	}
	
	private static void vPattern(Integer n)
	{
		if (DEBUG) System.out.printf("In vPattern(Int=%d)\n", n);
		
		for (int i = n; i > 0; i--) {
			for (int j = i; j < n; j++)
				System.out.print(" ");
			
			System.out.print((char) ('@' + i));
			
			for (int j = 1; j < 2 * (i - 1); j++)
				System.out.print(" ");
			
			if (i != 1)
				System.out.print((char) ('@' + i));
			
			System.out.println();
		}
	}
	
	private static void diamondNumbers(int n)
	{
		if (DEBUG) System.out.printf("In diamondNumbers(int=%d)\n", n);
		System.out.println("Numbers in diamond pattern: ");
		
		n = n % 2 == 0 ? n + 1 : n ;
		
		int num = 0;
		for (int i = 0; i < n; i++) {
			int space = Math.abs(n / 2 - i);
			if (i > Math.ceil(n / 2))
				num--;
			else
				num++;
					
			for (int j = 0; j < space; j++)
				System.out.print(" ");
			
			int k = -1;
			for (int j = num; j <= num; j += k) {
				if (j == 1)
					k = 1;
				System.out.print(j % 10);
			}
			
			System.out.println();
		}
	}
	
	private static void trapezium(Integer n)
	{
		if (DEBUG) System.out.printf("In trapezium(Int=%d)\n", n);
		System.out.println("Numbers in trapezium pattern: ");
		
		int back = n * (n + 1), front = 1;
		for (int i = 0; i < n; i++) {
			for (int j = 0; j < i; j++)
				System.out.print("  ");
			for (int j = 0; j < (n - i); j++)
				System.out.print(front++ + "*");
			for (int j = back - (n - i) + 1; j <= back; j++)
				System.out.print(j + (j == back ? "" : "*"));
			System.out.println();
			back -= n - i;
		}
	}
	
	private static void numberWithStars(int n)
	{
		if (DEBUG) System.out.printf("In numberWithStars(int=%d)\n", n);
		System.out.println("Numbers with star pattern: ");
		
		n = n % 2 == 0 ? n + 1 : n ;
		
		for (int i = 0; i < n; i++) {
			int space = Math.abs(n / 2 - i);
					
			for (int j = 0; j < space; j++)
				System.out.print(" ");
			
			int num = i > Math.floor(n / 2) ? n - i : i + 1 ;
			for (int j = 1; j <= num; j ++)
				System.out.print(j + (j == num ? "" : "*"));
			
			System.out.println();
		}
	}
	
	private static void hourGlass(int n)
	{
		if (DEBUG) System.out.printf("In hourGlass(int=%d)\n", n);
		System.out.println("Numbers in hour-glass pattern: ");
		
		for (int i = 1; i < 2 * n; i++) {
			int num = i > n ? 2 * n - i : i;
					
			for (int j = 0; j < num; j++)
				System.out.print(" ");
			
			for (int j = num; j <= n; j ++)
				System.out.print(j + " ");
			
			System.out.println();
		}
	}
	
